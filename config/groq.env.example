# NON-SECRET template. Put a NEW replacement key only in the ignored private .env.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
# Local assertions do not verify your billing plan. Check the Groq Console first.
GROQ_FREE_PLAN_CONFIRMED=false
ALLOW_FREE_API_CALLS=false
ALLOW_PAID_API_CALLS=false
API_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_INPUT_BYTES=12000
# OpenRouter-only fields must be empty for Groq.
LLM_REASONING_ENABLED=
LLM_INPUT_PRICE_CEILING=
LLM_OUTPUT_PRICE_CEILING=
