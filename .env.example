# ==========================================
# RAG HACKATHON - ENVIRONMENT TEMPLATE
# ==========================================
# This is a PUBLIC template.
# Never put real API keys in this file.
# Copy to .env and configure privately.

# ==========================================
# LLM PROVIDER
# ==========================================
# Options: mock, groq, openrouter, together, compatible
LLM_PROVIDER=mock

# ==========================================
# GROQ CLOUD - FREE PLAN
# ==========================================
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# Enable only after confirming your account is Free
GROQ_FREE_PLAN_CONFIRMED=false
ALLOW_FREE_API_CALLS=false

# Never enable paid calls for this hackathon
ALLOW_PAID_API_CALLS=false

# ==========================================
# OPENROUTER - OPTIONAL
# ==========================================
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# TOGETHER AI - OPTIONAL
# ==========================================
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.ai/v1

# ==========================================
# CUSTOM OPENAI-COMPATIBLE PROVIDER
# ==========================================
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ==========================================
# GENERATION SETTINGS
# ==========================================
API_TIMEOUT_SECONDS=30
MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0
LLM_TOP_P=1
LLM_RESPONSE_FORMAT=json_object
LLM_MAX_INPUT_BYTES=12000

# Optional provider-specific controls
LLM_REASONING_ENABLED=
LLM_INPUT_PRICE_CEILING=
LLM_OUTPUT_PRICE_CEILING=

# ==========================================
# RESERVED EMBEDDING METADATA (workspace.py uses the verified fixed local cache)
# ==========================================
EMBEDDING_MODEL=./models/multilingual-e5-small
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_DEVICE=cpu
HF_HOME=./.cache/huggingface

# ==========================================
# RESERVED DATABASE METADATA (pass the index path explicitly to ingest/open_index)
# ==========================================
QDRANT_PATH=./data/index/qdrant

# ==========================================
# RESERVED RETRIEVAL METADATA (configure RAGPolicy explicitly; these flags are not loaded)
# ==========================================
RETRIEVAL_TOP_K=5
ENABLE_RERANKER=false

# ==========================================
# RESERVED UI OPTIONS (no Frontend is implemented by this engine)
# ==========================================
UI_HOST=127.0.0.1
UI_SHARE=false
ENABLE_UPLOAD=false
ENABLE_HISTORY=false